<Window x:Class="GuitarPracticeStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuitarPracticeStudio.App"
        mc:Ignorable="d"
        Title="RiffLab"
        Icon="GuitarPracticeStudio.ico"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppPrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9C9E9"/>
            <Setter Property="BorderBrush" Value="#1E2A3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12,14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Margin="12,0,12,0">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Foreground="#78DAFF"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#151E33"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#46E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="24"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,24,22,12">
                    <TextBlock Text="Guitar" Foreground="#F3F8FF" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="PRACTICE STUDIO" Foreground="#46E5FF" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>

                <Separator Grid.Row="1" Margin="18,0,18,12" Background="#1E2A3F"/>

                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <Button x:Name="DashboardButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Dashboard"
                            Tag="◉"
                            Foreground="#F3F8FF"
                            FontWeight="SemiBold"
                            Background="#121A2E"
                            BorderBrush="#46E5FF"/>
                    <Button x:Name="PracticeButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Practice"
                            Tag="◔"/>
                    <Button x:Name="ExercisesButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Exercises"
                            Tag="✦"/>
                    <Button x:Name="ScalesButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Scales"
                            Tag="♭"/>
                    <Button x:Name="CalendarButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Calendar"
                            Tag="◫"/>
                    <Button x:Name="StatisticsButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Statistics"
                            Tag="▣"/>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Content="Settings"
                            Tag="⚙"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Margin="22,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <Border CornerRadius="24"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
                <ContentControl x:Name="PageHost" Margin="18"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
