<UserControl x:Class="RiffLab.App.Views.CalendarView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              mc:Ignorable="d"
              d:DesignHeight="700"
              d:DesignWidth="900"
              Background="#0E1220">

    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="18"
                    Background="#111827"
                    BorderBrush="#24314B"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PreviousMonthButton"
                            Grid.Column="0"
                            Width="90"
                            Height="36"
                            Content="Previous"
                            Background="#1A233B"
                            Foreground="#F3F8FF"
                            BorderBrush="#2B3B5D"
                            Click="PreviousMonthButton_Click"/>

                    <TextBlock x:Name="MonthLabel"
                               Grid.Column="1"
                               Text="Month"
                               Foreground="#F3F8FF"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button x:Name="AddPracticeButton"
                            Grid.Column="2"
                            Width="140"
                            Height="36"
                            Margin="0,0,12,0"
                            Content="+ Add Practice"
                            Background="#16273F"
                            Foreground="#F3F8FF"
                            BorderBrush="#46E5FF"
                            Click="AddPracticeButton_Click"/>

                    <Button x:Name="NextMonthButton"
                            Grid.Column="3"
                            Width="90"
                            Height="36"
                            Content="Next"
                            Background="#1A233B"
                            Foreground="#F3F8FF"
                            BorderBrush="#2B3B5D"
                            Click="NextMonthButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="#101A2D"
                        BorderBrush="#26395F"
                        BorderThickness="1"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Sun" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Column="1" Text="Mon" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Column="2" Text="Tue" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Column="3" Text="Wed" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Column="4" Text="Thu" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Column="5" Text="Fri" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Grid.Column="6" Text="Sat" Foreground="#A8B8D6" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        </Grid>

                        <Grid x:Name="CalendarGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        CornerRadius="20"
                        Background="#101A2D"
                        BorderBrush="#26395F"
                        BorderThickness="1"
                        Padding="18"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SelectedDateLabel"
                                   Text="Selected date"
                                   Foreground="#F3F8FF"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentStreakText"
                                   Text="Current streak: 0"
                                   Foreground="#46E5FF"
                                   FontSize="13"
                                   Margin="0,8,0,12"/>

                        <ItemsControl x:Name="SelectedDateSessions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#121A2E" BorderBrush="#2B3B5D" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Exercise}" Foreground="#F3F8FF" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DurationText}" Foreground="#9FB7D9" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Delete"
                                                    Width="72"
                                                    Height="28"
                                                    Margin="8,0,0,0"
                                                    Background="#1D1B2A"
                                                    Foreground="#F3F8FF"
                                                    BorderBrush="#9B7BFF"
                                                    Tag="{Binding Session}"
                                                    Click="DeleteSelectedDateSessionButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Popup x:Name="ManualEntryPopup"
               Placement="Center"
               IsOpen="False"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Width="420"
                    Background="#101A2D"
                    BorderBrush="#46E5FF"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Add Practice Session"
                               Foreground="#F3F8FF"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Date" Foreground="#DDEBFF" FontSize="12" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ManualPracticeDatePicker"
                                    Background="#121A2E"
                                    BorderBrush="#2B3B5D"
                                    Foreground="#F3F8FF"
                                    SelectedDateFormat="Short"
                                    CalendarStyle="{StaticResource DarkCalendarStyle}">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Background" Value="#121A2E"/>
                                    <Setter Property="BorderBrush" Value="#2B3B5D"/>
                                    <Setter Property="Foreground" Value="#F3F8FF"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Duration (minutes)" Foreground="#DDEBFF" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="ManualPracticeMinutesTextBox"
                                 Text="30"
                                 Background="#121A2E"
                                 BorderBrush="#2B3B5D"
                                 Foreground="#F3F8FF"
                                 Padding="8,6,8,6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <TextBlock Text="Exercise" Foreground="#DDEBFF" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ManualExerciseComboBox"
                                  Height="34"
                                  Background="#121A2E"
                                  BorderBrush="#2B3B5D"
                                  Foreground="#F3F8FF"
                                  Style="{StaticResource DarkComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,16">
                        <TextBlock Text="Notes (optional)" Foreground="#DDEBFF" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="ManualPracticeNotesTextBox"
                                 Height="80"
                                 Background="#121A2E"
                                 BorderBrush="#2B3B5D"
                                 Foreground="#F3F8FF"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8,6,8,6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelManualEntryButton"
                                Width="96"
                                Height="36"
                                Content="Cancel"
                                Margin="0,0,10,0"
                                Background="#1A233B"
                                Foreground="#F3F8FF"
                                BorderBrush="#2B3B5D"
                                Click="CancelManualEntryButton_Click"/>
                        <Button x:Name="SaveManualEntryButton"
                                Width="96"
                                Height="36"
                                Content="Save"
                                Background="#16273F"
                                Foreground="#F3F8FF"
                                BorderBrush="#46E5FF"
                                Click="SaveManualEntryButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
