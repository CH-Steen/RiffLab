<UserControl x:Class="GuitarPracticeStudio.App.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             Background="#0E1220">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="18"
                Background="#111827"
                BorderBrush="#24314B"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,18">
            <TextBlock Text="Practice" Foreground="#F3F8FF" FontSize="28" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="20"
                    Background="#101A2D"
                    BorderBrush="#26395F"
                    BorderThickness="1"
                    Padding="24"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Session Control"
                               Foreground="#46E5FF"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Border Grid.Row="1"
                            CornerRadius="18"
                            Background="#0F1523"
                            BorderBrush="#2B3B5D"
                            BorderThickness="1"
                            Padding="16,12,16,12"
                            Margin="0,0,0,18">
                        <TextBlock x:Name="TimerTextBlock"
                                   Text="00:00:00"
                                   Foreground="#F3F8FF"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Button x:Name="StartSessionButton"
                                Width="110"
                                Height="42"
                                Margin="0,0,12,0"
                                Content="Start"
                                Background="#1C2E44"
                                Foreground="#F3F8FF"
                                BorderBrush="#46E5FF"
                                BorderThickness="1"
                                Click="StartSessionButton_Click"/>
                        <Button x:Name="PauseSessionButton"
                                Width="110"
                                Height="42"
                                Margin="0,0,12,0"
                                Content="Pause"
                                Background="#1A233B"
                                Foreground="#F3F8FF"
                                BorderBrush="#2B3B5D"
                                BorderThickness="1"
                                Click="PauseSessionButton_Click"/>
                        <Button x:Name="ResumeSessionButton"
                                Width="110"
                                Height="42"
                                Margin="0,0,12,0"
                                Content="Resume"
                                Background="#1A233B"
                                Foreground="#F3F8FF"
                                BorderBrush="#2B3B5D"
                                BorderThickness="1"
                                Click="ResumeSessionButton_Click"/>
                        <Button x:Name="StopSessionButton"
                                Width="110"
                                Height="42"
                                Content="Stop"
                                Background="#1B1B2A"
                                Foreground="#F3F8FF"
                                BorderBrush="#9B7BFF"
                                BorderThickness="1"
                                Click="StopSessionButton_Click"/>
                    </StackPanel>

                    <Border Grid.Row="3"
                            CornerRadius="16"
                            Background="#121A2E"
                            BorderBrush="#2B3B5D"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Progress" Foreground="#46E5FF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ProgressBar Grid.Row="1" x:Name="SessionProgressBar" Height="11" Minimum="0" Maximum="100" Value="0" Foreground="#46E5FF" Background="#1A233B" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" x:Name="ProgressTextBlock"
                                       Text="00:00:00 / 00:30:00"
                                       Foreground="#DDEBFF"
                                       FontSize="13"
                                       Margin="0,0,0,8"/>
                            <Border Grid.Row="3"
                                    CornerRadius="12"
                                    Background="#0F1523"
                                    BorderBrush="#2B3B5D"
                                    BorderThickness="1"
                                    Padding="12"
                                    MinHeight="120">
                                <StackPanel>
                                    <TextBlock Text="Current Exercise" Foreground="#46E5FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="CurrentExerciseNameTextBlock"
                                               Text="Select an exercise to get started."
                                               Foreground="#F3F8FF"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CurrentExerciseDescriptionTextBlock"
                                               Text="Choose a warmup, scale, or technique exercise from the list to begin your practice session."
                                               Foreground="#9FB7D9"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                    <Border Margin="0,12,0,0"
                                            Height="42"
                                            CornerRadius="10"
                                            Background="#111827"
                                            BorderBrush="#2B3B5D"
                                            BorderThickness="1">
                                        <TextBlock Text="Tablature viewer placeholder"
                                                   Foreground="#7FE6FF"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    CornerRadius="20"
                    Background="#101A2D"
                    BorderBrush="#26395F"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Session Details" Foreground="#46E5FF" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>

                    <TextBlock Text="Exercise" Foreground="#DDEBFF" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ExerciseComboBox"
                              Height="38"
                              Margin="0,0,0,18"
                              Style="{StaticResource DarkComboBoxStyle}"/>

                    <TextBlock Text="Goal (minutes)" Foreground="#DDEBFF" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox x:Name="GoalMinutesTextBox"
                              Height="38"
                              Margin="0,0,0,18"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Background="#121A2E"
                              BorderBrush="#2B3B5D"
                              Foreground="#F3F8FF"
                              FontSize="14"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Text="30"/>

                    <TextBlock Text="Current status" Foreground="#DDEBFF" FontSize="13" Margin="0,0,0,8"/>
                    <Border CornerRadius="12" Background="#121A2E" BorderBrush="#2B3B5D" BorderThickness="1" Padding="14">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Idle"
                                   Foreground="#F3F8FF"
                                   FontSize="14"/>
                    </Border>

                    <TextBlock Text="Session summary" Foreground="#DDEBFF" FontSize="13" Margin="0,18,0,8"/>
                    <Border CornerRadius="12" Background="#121A2E" BorderBrush="#2B3B5D" BorderThickness="1" Padding="14">
                        <TextBlock x:Name="SessionSummaryTextBlock"
                                   Text="Ready to begin a focused practice session."
                                   Foreground="#9FB7D9"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border CornerRadius="16"
                            Background="#121A2E"
                            BorderBrush="#2B3B5D"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Metronome" Foreground="#46E5FF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="BPM" Foreground="#DDEBFF" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="MetronomeBpmTextBox"
                                         Width="60"
                                         Height="28"
                                         Background="#0F1523"
                                         BorderBrush="#2B3B5D"
                                         Foreground="#F3F8FF"
                                         Text="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextChanged="MetronomeBpmTextBox_TextChanged"/>
                            </StackPanel>

                            <Slider x:Name="MetronomeBpmSlider"
                                    Minimum="40"
                                    Maximum="240"
                                    Value="120"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,10"
                                    ValueChanged="MetronomeBpmSlider_ValueChanged"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Volume" Foreground="#DDEBFF" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="MetronomeVolumeTextBlock" Text="60%" Foreground="#F3F8FF" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Slider x:Name="MetronomeVolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="60"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,10"
                                    ValueChanged="MetronomeVolumeSlider_ValueChanged"/>

                            <TextBlock Text="Time signature" Foreground="#DDEBFF" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox x:Name="TimeSignatureComboBox"
                                      Height="34"
                                      Margin="0,0,0,12"
                                      Style="{StaticResource DarkComboBoxStyle}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button x:Name="MetronomeStartButton"
                                        Width="92"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Content="Start"
                                        Background="#1C2E44"
                                        Foreground="#F3F8FF"
                                        BorderBrush="#46E5FF"
                                        BorderThickness="1"
                                        Click="MetronomeStartButton_Click"/>
                                <Button x:Name="MetronomeStopButton"
                                        Width="92"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Content="Stop"
                                        Background="#1A1B2B"
                                        Foreground="#F3F8FF"
                                        BorderBrush="#9B7BFF"
                                        BorderThickness="1"
                                        Click="MetronomeStopButton_Click"/>
                                <Button x:Name="TapTempoButton"
                                        Width="92"
                                        Height="34"
                                        Content="Tap"
                                        Background="#1A233B"
                                        Foreground="#F3F8FF"
                                        BorderBrush="#2B3B5D"
                                        BorderThickness="1"
                                        Click="TapTempoButton_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Ellipse x:Name="BeatIndicator1" Width="12" Height="12" Fill="#2B3B5D" Stroke="#46E5FF" StrokeThickness="1" Margin="0,0,6,0"/>
                                <Ellipse x:Name="BeatIndicator2" Width="12" Height="12" Fill="#2B3B5D" Stroke="#46E5FF" StrokeThickness="1" Margin="0,0,6,0"/>
                                <Ellipse x:Name="BeatIndicator3" Width="12" Height="12" Fill="#2B3B5D" Stroke="#46E5FF" StrokeThickness="1" Margin="0,0,6,0"/>
                                <Ellipse x:Name="BeatIndicator4" Width="12" Height="12" Fill="#2B3B5D" Stroke="#46E5FF" StrokeThickness="1" Margin="0,0,6,0"/>
                                <Ellipse x:Name="BeatIndicator5" Width="12" Height="12" Fill="#2B3B5D" Stroke="#46E5FF" StrokeThickness="1" Margin="0,0,6,0"/>
                                <Ellipse x:Name="BeatIndicator6" Width="12" Height="12" Fill="#2B3B5D" Stroke="#46E5FF" StrokeThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
